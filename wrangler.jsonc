// Cloudflare Workers config for the hosted site (see "Hosting on Cloudflare" in the README).
// Build command: npm run build:map   (creates public/data/*.json from the SDE)
// Deploy command: npx wrangler deploy
{
  "name": "eve-arbi",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // sso.js uses node:crypto (PKCE) and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sso/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Session" }]
  },
  // No database_id: the first deploy creates each database (Wrangler automatic provisioning),
  // including Git-connected builds.
  //   CONTRACTS_DB: contract contents shared between visitors (/api/contract-items)
  //   USERS_DB:     signed-in characters' watchlists (/api/me/watchlists/*)
  "d1_databases": [
    { "binding": "CONTRACTS_DB", "database_name": "eve-arbi-contracts" },
    { "binding": "USERS_DB", "database_name": "eve-arbi-users" }
  ],
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  // EVE_CLIENT_ID, EVE_CALLBACK_URL and CONTACT are set in the dashboard; keep them on deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
