// Cloudflare Workers config for the hosted site (see "Hosting on Cloudflare" in the README).
// Build command: npm run build:map   (creates public/data/*.json from the SDE)
// Deploy command: npx wrangler deploy
{
  "name": "eve-arbi",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // sso.js uses node:crypto (PKCE) and Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sso/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Session" }]
  },
  // No database_id: the first deploy creates each database (Wrangler automatic provisioning),
  // including Git-connected builds.
  //   CONTRACTS_DB: contract contents shared between visitors (/api/contract-items)
  //   USERS_DB:     signed-in characters' watchlists (/api/me/watchlists/*)
  "d1_databases": [
    { "binding": "CONTRACTS_DB", "database_name": "eve-arbi-contracts" },
    { "binding": "USERS_DB", "database_name": "eve-arbi-users" }
  ],
  // HISTORY: 90 days of market history per item, for the Regional demand page (/api/demand/*).
  // R2 has to be enabled on the account (dashboard → R2) before the first deploy that includes it.
  "r2_buckets": [
    { "binding": "HISTORY", "bucket_name": "eve-arbi-history" }
  ],
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  // EVE_CLIENT_ID, EVE_CALLBACK_URL and CONTACT are set in the dashboard; keep them on deploy.
  "keep_vars": true,
  // Git-connected branch builds run `wrangler preview`, which needs this block. It mirrors the preview
  // bindings set in the Cloudflare dashboard (Workers → eve-arbi → Previews), so deploys keep them:
  // both D1 databases and the Session Durable Object namespace, by ID. SSO vars are unset there.
  "previews": {
    "d1_databases": [
      { "binding": "CONTRACTS_DB", "database_id": "852dda8a-9af2-44c3-a8a0-37c509d70efd" },
      { "binding": "USERS_DB", "database_id": "bee339b5-b2c5-4f2b-8dcd-d9d025c2d588" }
    ],
    "r2_buckets": [
      { "binding": "HISTORY", "bucket_name": "eve-arbi-history" }
    ],
    "unsafe": {
      "bindings": [
        { "name": "SESSIONS", "type": "durable_object_namespace", "class_name": "Session", "namespace_id": "bd4c9f2e21b143bf8850495fc015a71d" }
      ]
    },
    "observability": {
      "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
      "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
    }
  },
  "observability": { "enabled": true }
}
